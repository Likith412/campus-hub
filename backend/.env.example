# Copy to .env for local development. Render sets these in the dashboard instead.

PORT=8000
NODE_ENV=development

# MongoDB. Locally this is the docker-compose container; in production use an
# Atlas SRV string: mongodb+srv://user:pass@cluster.mongodb.net/campus-hub
DATABASE_URI=mongodb://localhost:27016/campus-hub

# Redis — rate limits, the token blacklist and the email queue.
REDIS_URL=redis://localhost:6378

# Auth. Generate the secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Cookies. Leave both unset locally: cookies are then host-only and SameSite=Strict,
# which is what works over http://localhost. In production the SPA and the API are
# different origins, so the code switches to SameSite=None automatically. Only set
# COOKIE_SAMESITE=strict (and COOKIE_DOMAIN) if you put both behind one domain.
# COOKIE_DOMAIN=
# COOKIE_SAMESITE=

# Where the SPA lives. Drives the CORS allow-list and the links inside emails.
FRONTEND_URL=http://localhost:5173

# Behind a reverse proxy (Render, nginx), the number of hops to trust for client IPs.
# TRUST_PROXY=1

# ── Email ────────────────────────────────────────────────────────────────────
# The sender, shared by both transports. In production it must be an address you
# have verified with Brevo.
MAIL_FROM_NAME=Campus Hub
MAIL_FROM_EMAIL=no-reply@example.com

# Development transport: SMTP via nodemailer. Leave SMTP_HOST blank and messages
# are printed to the console instead — the signup and reset flows still work.
# For Gmail you need 2-Step Verification on and an App Password, not your login.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Production transport: Brevo's HTTPS API, used whenever NODE_ENV=production.
# Render and most free hosts block outbound SMTP, so nodemailer cannot work there.
# Get a key at brevo.com and verify MAIL_FROM_EMAIL under Senders & IP.
BREVO_API_KEY=

# The bootstrap super admin, created by npm run db:init.
SUPERADMIN_EMAIL=superadmin@college.edu
SUPERADMIN_PASSWORD=
